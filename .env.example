# 天工平台环境变量样例（复制为 .env；.env 不入库）
# 模型密钥：变量名须形如 XXX_API_KEY / XXX_TOKEN，与 config/models.yaml 的 api_key_env 对应
OPENAI_API_KEY=sk-xxxx
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=

# 数据库（生产 MySQL 8，utf8mb4）
# TIANGONG_DB_URL=mysql+pymysql://user:pass@127.0.0.1:3306/tiangong?charset=utf8mb4

# 初始管理员口令：不设置则首启生成随机口令打印在日志并强制首登改密
# TIANGONG_ADMIN_PASSWORD=

# 源码部署脚本 scripts/server.sh 的监听地址与端口（走 Nginx 时 HOST 填 127.0.0.1）
# TIANGONG_HOST=0.0.0.0
# TIANGONG_PORT=8000

# 反向代理 IP（逗号分隔）：仅来自这些地址的请求才采信 X-Forwarded-For
# TIANGONG_TRUSTED_PROXIES=10.0.0.1

# 项目开放模式（默认开）：所有登录用户可见全部项目、可创建 / 修改项目与项目内数据，删除项目仅管理员；
# 设为 false 回到成员制（未加入项目不可见）
# TIANGONG_OPEN_PROJECTS=true
# 管理员可在「用户管理」页把数据可见范围切为「按业务线成员 / 按项目成员」，页面设置优先于此变量

# 生产建议保持关闭
# TIANGONG_EXPOSE_DOCS=false
# TIANGONG_LOG_RETENTION_DAYS=90      # AI 调用日志与操作日志（数据库）保留天数，启动时与之后每天清理
# TIANGONG_LOG_FILE_LEVEL=INFO        # 文件日志级别（排障时临时改 DEBUG，量会大很多）
# TIANGONG_LOG_FILE_MAX_MB=50         # 单个日志文件超过即轮转（另每日零点轮转）
# TIANGONG_LOG_FILE_RETENTION_DAYS=7  # 轮转后的日志保留天数（gzip 压缩）
# TIANGONG_CONSOLE_LOG=true           # 控制台输出；scripts/server.sh 启动时自动关掉，避免 logs/server.out 存一份重复日志
# TIANGONG_LLM_MAX_CONCURRENCY=4

# ---- Docker 部署（docker compose）专用 ----
# MySQL 容器口令；应用连接串由 docker-compose.yml 用 MYSQL_PASSWORD 自动拼出，无需再填 TIANGONG_DB_URL
# MYSQL_ROOT_PASSWORD=
# MYSQL_PASSWORD=
# 对外 HTTP 端口（默认 80）与时区
# HTTP_PORT=80
# TZ=Asia/Shanghai

# 需求分析准确率防线：独立复核 Agent（对照原文挑理解错 / 无依据 / 遗漏；关掉只做原文核验）
# 需求提取（分析前置）：附件解析完成后自动从全部材料逐字摘录需求内容归整为整理稿，AI 分析与测试设计以整理稿为准；关掉只能手动提取
# TIANGONG_REQUIREMENT_EXTRACT=true
# 需求提取用的模型（空则用默认模型）：提取是逐字摘录、输出量大，默认模型为省钱改成低档时在这里钉住提取模型
# TIANGONG_REQUIREMENT_EXTRACT_MODEL=gpt-6-astra
# TIANGONG_REQUIREMENT_EXTRACT_CROSSCHECK=true   # 提取最后整稿交叉核对（跨页面矛盾、疑似遗留草稿），多一次模型调用；false 关闭
# TIANGONG_POINT_EXTENSION=true   # 拆解测试点后再调一次模型做「经验延伸」：补需求没写到的并发 / 中断 / 跨天 / 越权 / 脏数据场景，标来源带依据、待审核；false 则只能在测试点页手动点
# TIANGONG_ANALYSIS_REVIEW=true
# 人工修改过的分析结果在确认时自动加入需求分析评测集作为标准答案
# TIANGONG_ANALYSIS_EVAL_AUTO_SAMPLE=true

# 同时执行的测试设计任务数，超出的排队（queued）；模型调用并发另见 TIANGONG_LLM_MAX_CONCURRENCY
TIANGONG_TASK_MAX_CONCURRENCY=2
